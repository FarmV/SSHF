<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="http://metro.mahapps.com/winfx/xaml/controls">

    <ResourceDictionary.MergedDictionaries>
        <!-- Основные стили элементов управления -->
        <ResourceDictionary Source="pack://application:,,,/MahApps.Metro;component/Styles/Controls.xaml" />
        <!-- Шрифты -->
        <ResourceDictionary Source="pack://application:,,,/MahApps.Metro;component/Styles/Fonts.xaml" />
        <!-- Базовая тёмная тема с акцентом -->
        <ResourceDictionary Source="pack://application:,,,/MahApps.Metro;component/Styles/Themes/Dark.Mauve.xaml" />
    </ResourceDictionary.MergedDictionaries>
    
         <Style x:Key="DarkMetroWindowButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource MahApps.Styles.Button}">
        <Setter Property="Foreground" Value="#FFE6E6E6"/>
        <!-- Базовый цвет текста/иконки -->
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Padding" Value="1"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <!-- ====================================================================== -->
    <!-- Кастомный стиль для ОБЫЧНЫХ кнопок окна (Свернуть, Развернуть) -->
    <!-- ====================================================================== -->
    <Style x:Key="CustomDarkMetroWindowButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource DarkMetroWindowButtonStyle}">
        <!-- Базовые сеттеры (некоторые наследуются, другие переопределяются в Template) -->
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <!-- Foreground и Background управляются через ControlTemplate -->

        <!-- Главное: Переопределяем шаблон ControlTemplate -->

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <!-- Основной контейнер кнопки: Border -->
                    <Border x:Name="BackgroundBorder" BorderThickness="0" SnapsToDevicePixels="True">
                        <!-- Определяем кисть для Foreground в ресурсах Border -->
                        <!-- Это позволит анимации найти ее по имени ForegroundBrush -->
                        <Border.Resources>
                            <SolidColorBrush x:Key="InternalForegroundBrush" x:Name="ForegroundBrush" Color="#FFE6E6E6"/>
                            <!-- Базовый цвет иконки 230,230,230 -->
                        </Border.Resources>

                        <!-- Устанавливаем наследуемый Foreground через TextElement -->
                        <!-- Используем созданную кисть -->
                        <TextElement.Foreground>
                            <StaticResource ResourceKey="InternalForegroundBrush"/>
                        </TextElement.Foreground>

                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="MouseOver">
                                    <Storyboard>
                                        <!-- Анимация фона -->
                                        <ColorAnimation Storyboard.TargetName="BackgroundBrush" Storyboard.TargetProperty="Color" To="#FF3E3E3E" Duration="0:0:0.018">
                                            <ColorAnimation.EasingFunction>
                                                <ExponentialEase EasingMode="EaseIn"/>
                                            </ColorAnimation.EasingFunction>
                                        </ColorAnimation>
                                        <!-- Анимация цвета ForegroundBrush -->
                                        <ColorAnimation Storyboard.TargetName="ForegroundBrush" Storyboard.TargetProperty="Color" To="#FFF0F0F0" Duration="0:0:0.018">
                                            <ColorAnimation.EasingFunction>
                                                <ExponentialEase EasingMode="EaseIn"/>
                                            </ColorAnimation.EasingFunction>
                                        </ColorAnimation>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <Storyboard>
                                        <!-- Анимация фона -->
                                        <ColorAnimation Storyboard.TargetName="BackgroundBrush" Storyboard.TargetProperty="Color" To="#FF505050" Duration="0:0:0.018">
                                            <ColorAnimation.EasingFunction>
                                                <ExponentialEase EasingMode="EaseIn"/>
                                            </ColorAnimation.EasingFunction>
                                        </ColorAnimation>
                                        <!-- Анимация цвета ForegroundBrush -->
                                        <ColorAnimation Storyboard.TargetName="ForegroundBrush" Storyboard.TargetProperty="Color" To="White" Duration="0:0:0.018">
                                            <ColorAnimation.EasingFunction>
                                                <ExponentialEase EasingMode="EaseIn"/>
                                            </ColorAnimation.EasingFunction>
                                        </ColorAnimation>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" Storyboard.TargetName="ContentPresenter" To="0.5" Duration="0"/>
                                        <!-- Можно также анимировать ForegroundBrush до серого цвета -->
                                        <!-- <ColorAnimation Storyboard.TargetName="ForegroundBrush" Storyboard.TargetProperty="Color" To="Gray" Duration="0"/> -->
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>

                        <!-- Фон задаем через именованную кисть -->
                        <Border.Background>
                            <SolidColorBrush x:Name="BackgroundBrush" Color="#FF2A2A2A"/>
                            <!-- Базовый фон 42,42,42 -->
                        </Border.Background>

                        <!-- ContentPresenter просто отображает контент, -->
                        <!-- цвет берется из TextElement.Foreground родителя (Border) -->
                        <ContentPresenter x:Name="ContentPresenter"
                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                                  Content="{TemplateBinding Content}"
                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                  ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                  />
                        <!-- Убрали некорректный <ContentPresenter.Foreground> -->
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="ContentPresenter" Property="Opacity" Value="0.5"/>
                            <!-- Можно также задать цвет ForegroundBrush через Setter -->
                            <!-- <Setter TargetName="ForegroundBrush" Property="Color" Value="Gray"/> -->
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>


    </Style>

    <!-- Кастомизированный стиль для светлых кнопок --><!--
    <Style x:Key="CustomLightMetroWindowButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource LightMetroWindowButtonStyle}">
        <Setter Property="Foreground" Value="Chocolate"/>
        --><!-- Цвет текста для светлой кнопки --><!--
    </Style>-->

    <!-- Стиль для WindowButtonCommands -->
    <Style TargetType="{x:Type controls:WindowButtonCommands}" BasedOn="{StaticResource {x:Type controls:WindowButtonCommands}}">
        <!--<Setter Property="LightMinButtonStyle" Value="{StaticResource CustomLightMetroWindowButtonStyle}" />
        <Setter Property="LightMaxButtonStyle" Value="{StaticResource CustomLightMetroWindowButtonStyle}" />
        <Setter Property="LightCloseButtonStyle" Value="{StaticResource CustomLightMetroWindowButtonStyle}" />-->
        <Setter Property="DarkMinButtonStyle" Value="{StaticResource CustomDarkMetroWindowButtonStyle}" />
        <Setter Property="DarkMaxButtonStyle" Value="{StaticResource CustomDarkMetroWindowButtonStyle}" />
        <Setter Property="DarkCloseButtonStyle" Value="{StaticResource CustomDarkMetroWindowButtonStyle}" />
    </Style>

</ResourceDictionary>