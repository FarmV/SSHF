<packageNamespaceMahApps:MetroWindow    
    xmlns                                     = "http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x                                   = "http://schemas.microsoft.com/winfx/2006/xaml" 
    xmlns:d                                   = "http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc                                  = "http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable                              = "d"
    xmlns:diag                                = "clr-namespace:System.Diagnostics;assembly=WindowsBase"
    xmlns:sys                                 = "clr-namespace:System;assembly=mscorlib"
                                              
    xmlns:packageNamespaceMahApps             = "http://metro.mahapps.com/winfx/xaml/controls"
    xmlns:packageNamespaceBehaviors           = "http://schemas.microsoft.com/xaml/behaviors"    
    xmlns:packageNamespaceMahAppsMetroActions = "clr-namespace:MahApps.Metro.Actions;assembly=MahApps.Metro"    
    xmlns:packageNamespaceR3                  = "clr-namespace:R3;assembly=R3"    
                                              
    x:Name                                    = "Fast"
    x:Class                                   = "FVH.SSHF.FastWindowArea.FastWindow"    
    xmlns:namespaceFastWindowArea             = "clr-namespace:FVH.SSHF.FastWindowArea"
    xmlns:namespaceConverters                 = "clr-namespace:FVH.SSHF.Infrastructure.Converters"   
    
   
    d:DataContext = "{ d:DesignInstance Type = namespaceFastWindowArea:FastWindowViewModel,  IsDesignTimeCreatable = True }"
                
    Visibility           = "Visible"
    WindowStyle          = "None"      
    AllowsTransparency   = "True"
    Topmost              = "True" 
    SizeToContent        = "Manual"   
    ResizeMode           = "NoResize"

    ShowInTaskbar        = "False"    
    ShowTitleBar         = "False"
    ShowMinButton        = "False"
    ShowCloseButton      = "False"
    ShowMaxRestoreButton = "False"
    NonActiveBorderBrush = "Transparent"   
    
   >

    <Window.Resources>
        <namespaceConverters:ConverterImageDPIViewport x:Key="KeyConverterImageDPIViewport"/>
        <namespaceConverters:ConverterVisibleToOpacity x:Key="KeyConverterVisibleToOpacity"/>
    </Window.Resources>

    <packageNamespaceBehaviors:Interaction.Triggers>

        <packageNamespaceBehaviors:EventTrigger EventName="PreviewMouseDoubleClick" >

            <packageNamespaceBehaviors:InvokeCommandAction 
                Command = "{ Binding HideWindow }" 
            ></packageNamespaceBehaviors:InvokeCommandAction>

        </packageNamespaceBehaviors:EventTrigger>

    </packageNamespaceBehaviors:Interaction.Triggers>

    <Grid x:Name="GridContent" >

        <packageNamespaceBehaviors:Interaction.Triggers>

            <packageNamespaceBehaviors:EventTrigger EventName="PreviewMouseLeftButtonDown" >

                <packageNamespaceBehaviors:InvokeCommandAction                     
                    Command = "{ Binding StopWindowUpdater }" 
                ></packageNamespaceBehaviors:InvokeCommandAction>

            </packageNamespaceBehaviors:EventTrigger>

            <packageNamespaceBehaviors:EventTrigger EventName = "MouseLeftButtonDown" >

                <packageNamespaceBehaviors:InvokeCommandAction 
                    Command = "{ Binding DragMoveWindow }" 
                ></packageNamespaceBehaviors:InvokeCommandAction>

            </packageNamespaceBehaviors:EventTrigger>

            <packageNamespaceBehaviors:EventTrigger EventName="PreviewMouseMove" >

                <packageNamespaceBehaviors:InvokeCommandAction 
                    Command="{ Binding DropImage }"                                  
                    PassEventArgsToCommand="True"
                ></packageNamespaceBehaviors:InvokeCommandAction>

            </packageNamespaceBehaviors:EventTrigger>

        </packageNamespaceBehaviors:Interaction.Triggers>

        <Grid.Style>

            <Style TargetType="{ x:Type Grid }" >

                <Setter Property="Background" >

                    <Setter.Value>

                        <Binding                              
                             Path = "BackgroundImage.Value"
                             UpdateSourceTrigger="PropertyChanged"
                             Converter = "{ StaticResource KeyConverterImageDPIViewport }"
                        ></Binding>

                    </Setter.Value>

                </Setter>

                <Setter Property="Opacity" >

                    <Setter.Value>

                        <Binding 
                            Path = "VisibleCondition.Value" 
                            Converter = "{ StaticResource KeyConverterVisibleToOpacity }"
                        ></Binding>

                    </Setter.Value>

                </Setter>

            </Style>

        </Grid.Style>

    </Grid>

</packageNamespaceMahApps:MetroWindow>