<packageNamespaceMahApps:MetroWindow x:Name   = "NameNotification"
    xmlns                                     = "http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x                                   = "http://schemas.microsoft.com/winfx/2006/xaml" 
    xmlns:mc                                  = "http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:designTime                          = "http://schemas.microsoft.com/expression/blend/2008"
    mc:Ignorable                              = "designTime"
    xmlns:diag                                = "clr-namespace:System.Diagnostics;assembly=WindowsBase"
    xmlns:sys                                 = "clr-namespace:System;assembly=mscorlib"
                                              
    xmlns:packageNamespaceMahApps             = "http://metro.mahapps.com/winfx/xaml/controls"
    xmlns:packageNamespaceRXUI                = "clr-namespace:System.Reactive;assembly=System.Reactive"
    xmlns:packageNamespaceBehaviors           = "http://schemas.microsoft.com/xaml/behaviors"    
    xmlns:packageNamespaceMahAppsMetroActions = "clr-namespace:MahApps.Metro.Actions;assembly=MahApps.Metro"    
                                              
    x:Class                                   = "FVH.SSHF.NotificationWindowArea.NotificationWindow"    
    xmlns:namespaceNotificationWindowArea     = "clr-namespace:FVH.SSHF.NotificationWindowArea"
    xmlns:namespaceConverters                 = "clr-namespace:FVH.SSHF.Infrastructure.Converters" 
    xmlns:namespaceWidnows                    = "clr-namespace:FVH.SSHF.Windows"
                   
    Title                = "Notification"
    Visibility           = "Visible"
    WindowStyle          = "None"      
    AllowsTransparency   = "True"
    Topmost              = "True" 
    SizeToContent        = "Manual"   
    ResizeMode           = "NoResize"

    ShowInTaskbar        = "False"    
    ShowTitleBar         = "False"
    ShowMinButton        = "False"
    ShowCloseButton      = "False"
    ShowMaxRestoreButton = "False"
    NonActiveBorderBrush = "Transparent"
    
                                
    Height="{Binding MonitorResolution.Height}"
    Width="{Binding MonitorResolution.Width}"
                                     
    
    designTime:DataContext = "{ designTime:DesignInstance Type = namespaceNotificationWindowArea:NotificationWindowViewModel, IsDesignTimeCreatable = True }"    
   >


    <Window.Resources>
        <namespaceConverters:ConverterImageDPIViewport x:Key="KeyConverterImageDPIViewport"/>
        <namespaceConverters:ConverterVisibleToOpacity x:Key="KeyConverterVisibleToOpacity"/>
    </Window.Resources>

